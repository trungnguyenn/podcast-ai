    "loudness_normalization": {
      "enabled": true,
      "integrated_lufs": -16,
      "true_peak_dbtp": -1.5,
      "lra": 8
    },
    "segment_title_announcement": {
      "enabled": true,
      "speaker": "HOST",
      "tts_profile": "host_transition",
      "pace_profile": "host_broadcast",
      "template": {
        "vi": "Bây giờ, chúng ta chuyển sang {title}.",
